{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go (deepseek/glm/qwen/kimi/minimax)",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (Go)",
          "tool_call": true,
          "reasoning": true
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (Go)",
          "tool_call": true,
          "reasoning": true
        },
        "glm-5.2": {
          "name": "GLM 5.2 (Go)",
          "tool_call": true,
          "reasoning": true
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max (Go)",
          "tool_call": true,
          "reasoning": true
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code (Go)",
          "tool_call": true,
          "reasoning": true
        },
        "minimax-m3": {
          "name": "MiniMax M3 (Go)",
          "tool_call": true,
          "reasoning": true
        }
      }
    }
  },
  "model": "deepseek/deepseek-v4-flash",
  "lsp": true,
  "formatter": {
    "ruff": {
      "command": [
        "ruff",
        "format",
        "$FILE"
      ],
      "extensions": [
        ".py"
      ]
    }
  },
  "permission": {
    "edit": {
      "*": "allow",
      ".github/workflows/**": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "sudo *": "deny",
      "curl * | *sh*": "deny"
    },
    "webfetch": "allow"
  }
}
