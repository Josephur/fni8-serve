+static void common_chat_qwen_think_fallback(common_chat_msg & msg, bool is_partial, const common_chat_parser_params & params) {
+    if (params.reasoning_format != COMMON_REASONING_FORMAT_DEEPSEEK || !msg.reasoning_content.empty()) {
+        return;
+    }
+
+    std::string content = msg.content;
+    const auto first_non_ws = content.find_first_not_of(" \n\r\t");
+    if (first_non_ws == std::string::npos) {
+        return;
+    }
+
+    auto ltrim = [](std::string s) {
+        const auto pos = s.find_first_not_of(" \n\r\t");
+        if (pos == std::string::npos) {
+            return std::string();
+        }
+        return s.substr(pos);
+    };
+
+    if (content.compare(first_non_ws, 7, "<think>") == 0) {
+        const auto reasoning_start = first_non_ws + 7;
+        const auto reasoning_end = content.find("</think>", reasoning_start);
+        if (reasoning_end == std::string::npos) {
+            if (is_partial) {
+                msg.reasoning_content = content.substr(reasoning_start);
+                msg.content.clear();
+            }
+            return;
+        }
+
+        msg.reasoning_content = content.substr(reasoning_start, reasoning_end - reasoning_start);
+        msg.content = ltrim(content.substr(reasoning_end + 8));
+
+        bool all_whitespace = true;
+        for (char c : msg.reasoning_content) {
+            if (c != ' ' && c != '\n' && c != '\r' && c != '\t') {
+                all_whitespace = false;
+                break;
+            }
+        }
+        if (all_whitespace) {
+            msg.reasoning_content.clear();
+        }
+        return;
+    }
+
+    if (content.compare(first_non_ws, 8, "</think>") == 0) {
+        msg.content = ltrim(content.substr(first_non_ws + 8));
+    }
+}
